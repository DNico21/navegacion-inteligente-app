# Copia este archivo como .env y rellena tus credenciales
# NUNCA subas .env al repositorio

# Firebase — obtener en: Firebase Console > Configuración del proyecto > SDK
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps / Directions API — obtener en: console.cloud.google.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth (Sign in with Google) — obtener en:
# Firebase Console > Authentication > Sign-in method > Google > Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
